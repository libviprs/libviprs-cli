#!/usr/bin/env bash
# The test half of CI, on MARS (see tools/gate.sh).
#
# Test-first work: if the tip of what is being pushed has a subject starting "Red tests",
# or VIPRS_RED=1 is set, the tests are not run (they are red on purpose) and the push says so.
# The pre-commit lint still ran, so a red commit has to compile and be clippy clean.
set -euo pipefail
gate="$(cd "$(dirname "$0")" && pwd)/../gate.sh"

red=${VIPRS_RED:-}
pushing=
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case $local_sha in *[!0]*) ;; *) continue ;; esac   # a delete pushes nothing
  pushing=1
  case $(git log -1 --format=%s "$local_sha") in "Red tests"*) red=1 ;; esac
done

[ -n "$pushing" ] || exit 0
if [ -n "$red" ]; then
  echo "pre-push: tip is a red-tests commit (or VIPRS_RED=1), so the test gate is skipped." >&2
  exit 0
fi
exec "$gate" test
